# ──────────────────────────────────────────────────────────────────────────────
# HempForge — environment configuration
# ──────────────────────────────────────────────────────────────────────────────
# HempForge is fully deterministic. No cloud LLM is required.
# Optional Ollama remains supported as a local model server for environments
# where engineers want it; the platform operates the same with or without it.

# ─── Node runtime ─────────────────────────────────────────────────────────────
# Set to "production" for deployed environments. Anything else is treated as
# development and enables the dev-token middleware (see authMiddleware).
NODE_ENV=development

# Serve the prebuilt SPA (dist/) instead of running a Vite dev server.
# Required in demo containers. Local `npm run dev` leaves this unset.
SERVE_STATIC=false

# ─── Required in production ───────────────────────────────────────────────────
# Firebase project ID. Must match the firebase-applet-config.json projectId.
# Production refuses to start without this.
FIREBASE_PROJECT_ID=

# HMAC-SHA256 secret used to sign COAs. Must be at least 32 characters.
# Production refuses to start without this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COA_SIGNING_SECRET=

# Comma-separated allow-list of origins permitted to call the API.
# REQUIRED in production — server refuses to start without it.
# Example: CORS_ORIGIN=https://app.hempforge.com,https://admin.hempforge.com
CORS_ORIGIN=

# ─── Supabase (production data + auth) ────────────────────────────────────────
# When set, the server uses Supabase Postgres (documents table) instead of
# Firestore/local fallback, and validates Supabase JWTs in authMiddleware.
# Client build uses VITE_* versions (see vite env below).
SUPABASE_URL=https://exjoyfdbgllkptniywpd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Stripe billing ───────────────────────────────────────────────────────────
# Server secret key. Never expose to the client.
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` or the dashboard:
STRIPE_WEBHOOK_SECRET=
# Recurring price ids for each plan (created in Stripe dashboard / CLI).
STRIPE_PRICE_PILOT_ID=
STRIPE_PRICE_STANDARD_ID=
STRIPE_PRICE_ENTERPRISE_ID=

# ─── Optional ────────────────────────────────────────────────────────────────
# Public URL where the applet is hosted (used for COA verification links).
APP_URL="http://localhost:3000"

# Administration & GxP auditor email. Used as a hint by deriveTenantAndRole
# in non-production environments only — production enforces custom claims.
ADMIN_EMAIL="admin@hempforge.lan"
VITE_ADMIN_EMAIL="admin@hempforge.lan"

# Use local in-memory DB fallback instead of Firestore (dev only).
# When true, all data is written to local-db-fallback.json and lost on restart.
USE_LOCAL_DB_FALLBACK=true

# ─── Local Ollama (optional) ────────────────────────────────────────────────
# HempForge is fully deterministic and does not require Ollama. If Ollama is
# reachable, it is used as an optional local model server. Leave OLLAMA_HOST
# unset to disable.
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# ─── Autonomy cron schedule (minutes) ────────────────────────────────────────
# How often the autonomous agent pipeline runs in the background.
AUTONOMY_SHORT_CYCLE_MIN=5
AUTONOMY_FULL_CYCLE_MIN=60

# ─── mem0 memory server (sidecar) ────────────────────────────────────────────
# mem0 runs as a FastAPI sidecar with pgvector + Neo4j backends.
# Start with: docker compose -f docker-compose.mem0.yml up -d
MEM0_API_URL="http://localhost:8888"
MEM0_LLM_MODEL="gpt-4o-mini"
MEM0_EMBEDDING_MODEL="text-embedding-3-small"
MEM0_PGVECTOR_PASSWORD="mem0_secret"
MEM0_NEO4J_PASSWORD="mem0_secret"

# ─── ResearchClaw sidecar ─────────────────────────────────────────────────────
# ResearchClaw runs as a Docker sidecar on port 8080.
# Start with: docker compose -f docker-compose.researchclaw.yml up -d
RESEARCHCLAW_URL="http://localhost:8080"

# ─── BlackMind LLM SDK keys (optional — engines work deterministically without) ─
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Dev-token authentication (NEVER set in production) ─────────────────────
# When NODE_ENV is not "production", the API accepts bearer tokens of the
# form:   dev-<uid>:<email>:<tenantId>:<role>
# Example: dev-alice:alice@acme.test:tenant-acme:Lab%20Admin
# Production authMiddleware returns 401 for any token starting with "dev-".
# ─────────────────────────────────────────────────────────────────────────────